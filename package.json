{
  "name": "ora",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "db:up": "docker compose up -d postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/db-reset.ts",
    "db:seed": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed.ts",
    "setup": "pnpm db:migrate && pnpm xrpl:setup && pnpm db:seed",
    "demo:reset": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed.ts --reset",
    "xrpl:setup": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/xrpl-setup.ts",
    "xrpl:smoke": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/xrpl-smoke.ts",
    "x402:smoke": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/x402-smoke.ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@electric-sql/pglite": "^0.5.8",
    "ai": "^7.0.92",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.11",
    "lucide-react": "^1.41.0",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "x402-xrpl": "^0.3.2",
    "xrpl": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^5.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver",
      "@tailwindcss/oxide",
      "sharp"
    ]
  }
}
