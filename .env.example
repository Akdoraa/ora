# ─── Ora — environment ───────────────────────────────────────────────────────
# Copy to .env.local and fill in. NEVER commit .env.local.
# `src/env.ts` validates all of this with Zod at boot.

# App
NODE_ENV=development
# Public-facing base URL for links shown to payers/merchants (checkoutUrl,
# manifestUrl, webhookUrl). Point this at a tunnel/deployment domain if the
# app needs to be reachable off this machine.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The server's own address, for the agent's internal x402 self-call. Leave
# this on localhost even when APP_URL points at a public tunnel — that call
# never needs to leave the machine, and a tunnel domain is slower/flakier.
INTERNAL_APP_URL=http://localhost:3000
# openssl rand -hex 32
SESSION_SECRET=dev-only-insecure-session-secret-change-me
WEBHOOK_SIGNING_SECRET=dev-only-insecure-webhook-secret-change-me
LOG_LEVEL=info

# Database.
# Default (unset): embedded PGlite at ./.pglite — zero infra, `pnpm db:push && pnpm db:seed`.
# For real Postgres (docker compose up -d postgres, or Neon in prod), set:
# DATABASE_URL=postgresql://ora:ora@localhost:5432/ora
PGLITE_DATA_DIR=./.pglite

# ─── AI agent ────────────────────────────────────────────────────────────────
# Without a key the agent runs in deterministic `demo` mode (still a full,
# auditable tool-using run). Set a key for the graded live demo.
ANTHROPIC_API_KEY=
AGENT_MODE=auto            # auto | live | demo
AGENT_MODEL=claude-sonnet-5

# ─── XRPL (Testnet) ──────────────────────────────────────────────────────────
XRPL_NETWORK=testnet
NEXT_PUBLIC_XRPL_NETWORK=testnet
XRPL_WSS_URL=wss://s.altnet.rippletest.net:51233
XRPL_RPC_URL=https://s.altnet.rippletest.net:51234
XRPL_EXPLORER_URL=https://testnet.xrpl.org
XRPL_SOURCE_TAG=20260530

# Server-held wallet seeds. Run `pnpm xrpl:setup` to create + faucet-fund these
# and append them here automatically. Never expose to the client.
XRPL_SETTLEMENT_SEED=
XRPL_ORACLE_SEED=
XRPL_AGENT_SEED=
XRPL_MERCHANT_SEED=

# RLUSD on XRPL Testnet — verify against tryrlusd.com before mainnet.
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
RLUSD_CURRENCY_HEX=524C555344000000000000000000000000000000

# ─── x402 ────────────────────────────────────────────────────────────────────
# Empty => Ora runs its own in-process facilitator verifying against XRPL Testnet.
X402_FACILITATOR_URL=
X402_ORACLE_PRICE_RLUSD=0.50
